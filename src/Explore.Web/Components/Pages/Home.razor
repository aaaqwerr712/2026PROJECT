@page "/"
@rendermode InteractiveServer
@inject ExploreApiClient Api
<PageTitle>地方誌｜走進地方，看見故事</PageTitle>
<section class="editorial section">
    <div class="section-kicker"><span>本期精選</span><span>VOL. 01 — 地方的日常</span></div>
    @if (featured.Length > 0)
    {
        var lead = featured[0];
        <div class="feature-grid">
            <a class="feature-story" href="/places/@lead.Id">
                <PlaceVisual Place="lead" />
                <span class="category">@lead.Category</span>
                <h1>@lead.Name</h1>
                <p>@lead.Summary</p>
                <span class="read-more">走進地方故事 ↗</span>
            </a>
            <aside class="feature-aside">
                <span class="aside-label">沿途，值得停留</span>
                @foreach (var place in featured.Skip(1).Take(2))
                {
                    <a href="/places/@place.Id">
                        <span class="category">@place.Category</span>
                        <h2>@place.Name</h2><p>@place.Summary</p>
                        <span class="meta">建議停留 · 約 @place.VisitMinutes 分鐘</span>
                    </a>
                }
                <a class="aside-route" href="/trails">把散落的故事，串成一條路線 <span>→</span></a>
            </aside>
        </div>
    }
    else if (!loading && !error)
    {
        <h1>地方故事，正在準備中。</h1><p>發布第一個景點後，就會出現在這裡。</p>
    }
</section>
<section id="explore" class="section"><div class="section-heading"><h2>探索地方<span>DISCOVER</span></h2><span class="muted">每個地方，都值得被好好認識。</span></div>
<div class="filters"><div class="chips">@foreach(var item in categories){<button aria-pressed="@(category == item)" class="@(category == item ? "selected" : "")" @onclick="() => Select(item)">@item</button>}</div><form @onsubmit="Load" @onsubmit:preventDefault><label class="sr-only" for="search">搜尋景點</label><input id="search" @bind="search" placeholder="搜尋景點、地方故事…" /><button type="submit">搜尋 ↗</button></form></div>
<div class="loading-status" role="status" aria-live="polite">@if(loading){<span class="loading-dot" aria-hidden="true"></span><span>正在載入地方故事…</span>}</div>
@if(error){<div class="notice" role="alert">暫時無法取得資料。<button @onclick="Load">重新載入</button></div>}
else{<p class="result-count" aria-live="polite">@places.Length 個探索提案 <span>DEMO COLLECTION</span></p><div @key="resultsVersion" class="place-grid" aria-busy="@loading">@foreach(var p in places){<a href="/places/@p.Id" class="place-card"><PlaceVisual Place="p" /><div class="card-copy"><span class="category">@p.Category</span><h3>@p.Name</h3><p>@p.Summary</p><div class="card-meta">示範據點 <span>建議停留 @p.VisitMinutes 分鐘 ↗</span></div></div></a>}</div>@if(!loading && places.Length==0){<div class="notice">找不到符合的景點，試試其他關鍵字。<button @onclick="Reset">清除篩選</button></div>}}
</section>
<section class="trail-banner"><span class="eyebrow">WALK WITH A STORY</span><h2>用一個午後，<br />走進地方的日常。</h2><p>兩條主題路線，從老城巷弄到山海之間，找到適合你的步調。</p><a href="/trails" class="button">探索主題路線 ↗</a></section>
@code{
Place[] places=[],featured=[];string search="",category="全部景點";bool loading=true,error;int requestVersion,resultsVersion;
readonly string[] categories=["全部景點","文化走讀","自然風景","地方工藝"];
protected override async Task OnInitializedAsync(){ await Load(); featured=places.Take(3).ToArray(); }
async Task Select(string value){if(category==value)return;category=value;await Load();}
async Task Reset(){search="";category="全部景點";await Load();}
async Task Load()
{
    var version = ++requestVersion;
    loading = true;
    error = false;
    try
    {
        var result = await Api.GetPlacesAsync(search, category == "全部景點" ? null : category);
        if (version != requestVersion) return;
        places = result;
        resultsVersion++;
    }
    catch (HttpRequestException) { if (version == requestVersion) error = true; }
    catch (TaskCanceledException) { if (version == requestVersion) error = true; }
    finally { if (version == requestVersion) loading = false; }
}
}
