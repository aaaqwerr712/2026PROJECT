@baseUrl = http://localhost:5080
# 在 HTTP client 的私有環境設定 adminKey，不要提交真實金鑰。
@adminKey = REPLACE_IN_PRIVATE_ENVIRONMENT

GET {{baseUrl}}/api/v1/places

###
GET {{baseUrl}}/api/v1/places/1

###
GET {{baseUrl}}/api/v1/trails

###
POST {{baseUrl}}/api/v1/admin/places
Content-Type: application/json
X-Admin-Key: {{adminKey}}

